// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model Module {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("modules")
}

model Department {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("departments")
}

enum PositionType {
  manager
  staf
  magang
}

model Position {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  positionType PositionType @map("position_type")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  employees Employee[]

  @@map("positions")
}

model Province {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  regencies Regency[]

  @@map("provinces")
}

model Regency {
  id         Int      @id @default(autoincrement())
  provinceId Int      @map("province_id")
  code       String   @unique
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  province  Province   @relation(fields: [provinceId], references: [id])
  districts District[]

  @@map("regencies")
}

model District {
  id        Int      @id @default(autoincrement())
  regencyId Int      @map("regency_id")
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  regency   Regency    @relation(fields: [regencyId], references: [id])
  employees Employee[]

  @@map("districts")
}

enum EmploymentType {
  pkwtt
  pkwt
  magang
}

enum EmployeeStatus {
  active
  inactive
}

model Employee {
  id             Int            @id @default(autoincrement())
  nip            String         @unique
  name           String
  email          String         @unique
  phone          String
  photoPath      String?        @map("photo_path")
  birthPlace     String         @map("birth_place")
  birthDate      DateTime       @map("birth_date") @db.Date
  maritalStatus  String         @map("marital_status")
  childrenCount  Int            @map("children_count")
  joinedAt       DateTime       @map("joined_at") @db.Date
  positionId     Int            @map("position_id")
  departmentId   Int            @map("department_id")
  employmentType EmploymentType @map("employment_type")
  gender         String
  distanceKm     Decimal        @map("distance_km") @db.Decimal(6, 2)
  districtId     Int            @map("district_id")
  fullAddress    String         @map("full_address") @db.Text
  status         EmployeeStatus
  createdBy      Int?           @map("created_by")
  updatedBy      Int?           @map("updated_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  position                  Position                   @relation(fields: [positionId], references: [id])
  department                Department                 @relation(fields: [departmentId], references: [id])
  district                  District                   @relation(fields: [districtId], references: [id])
  educations                EmployeeEducation[]
  user                      User?
  attendances               Attendance[]
  attendanceSummaries       AttendanceSummary[]
  transportAllowanceDetails TransportAllowanceDetail[]

  @@map("employees")
}

enum UserStatus {
  active
  inactive
}

model User {
  id                Int        @id @default(autoincrement())
  employeeId        Int?       @unique @map("employee_id")
  roleId            Int        @map("role_id")
  name              String
  username          String     @unique
  email             String?    @unique
  cellphone         String?    @unique
  password          String
  status            UserStatus
  passwordChangedAt DateTime?  @map("password_changed_at")
  lastLoginAt       DateTime?  @map("last_login_at")
  lastLogoutAt      DateTime?  @map("last_logout_at")
  rememberToken     String?    @map("remember_token")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  employee                   Employee?                   @relation(fields: [employeeId], references: [id])
  role                       Role                        @relation(fields: [roleId], references: [id])
  loginOtps                  LoginOtp[]
  sessions                   UserSession[]
  activityLogs               ActivityLog[]
  attendanceImports          AttendanceImport[]
  createdTransportSettings   TransportAllowanceSetting[]
  calculatedTransportPeriods TransportAllowancePeriod[]

  @@map("users")
}

model LoginOtp {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  otpHash    String    @map("otp_hash")
  channel    String
  sentTo     String    @map("sent_to")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  usedAt     DateTime? @map("used_at")
  ipAddress  String    @map("ip_address")
  userAgent  String    @map("user_agent") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("login_otps")
}

model UserSession {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  sessionToken   String    @unique @map("session_token")
  rememberMe     Boolean   @map("remember_me")
  ipAddress      String    @map("ip_address")
  userAgent      String    @map("user_agent") @db.Text
  lastActivityAt DateTime  @map("last_activity_at")
  expiresAt      DateTime  @map("expires_at")
  loggedOutAt    DateTime? @map("logged_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

enum ActivityAction {
  login
  logout
  create
  read
  update
  delete
}

model ActivityLog {
  id          Int            @id @default(autoincrement())
  userId      Int?           @map("user_id")
  moduleCode  String         @map("module_code")
  action      ActivityAction
  description String         @db.Text
  subjectType String?        @map("subject_type")
  subjectId   Int?           @map("subject_id")
  ipAddress   String         @map("ip_address")
  userAgent   String         @map("user_agent") @db.Text
  oldValues   Json?          @map("old_values")
  newValues   Json?          @map("new_values")
  url         String         @db.Text
  method      String
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model EmployeeEducation {
  id             Int      @id @default(autoincrement())
  employeeId     Int      @map("employee_id")
  educationLevel String   @map("education_level")
  schoolName     String   @map("school_name")
  graduationYear Int      @map("graduation_year")
  sortOrder      Int      @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_educations")
}

enum ImportStatus {
  queued
  processing
  completed
  failed
}

model AttendanceImport {
  id               Int          @id @default(autoincrement())
  userId           Int          @map("user_id")
  originalFilename String       @map("original_filename")
  periodYear       Int          @map("period_year")
  periodMonth      Int          @map("period_month")
  status           ImportStatus
  totalRows        Int          @map("total_rows")
  processedRows    Int          @map("processed_rows")
  errorMessage     String?      @map("error_message") @db.Text
  startedAt        DateTime?    @map("started_at")
  finishedAt       DateTime?    @map("finished_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id])
  attendances Attendance[]

  @@map("attendance_imports")
}

enum AttendanceType {
  hadir
  cuti
  izin
  unpaid_leave
}

enum AttendanceStatus {
  terpenuhi
  tidak_terpenuhi
}

model Attendance {
  id                 Int              @id @default(autoincrement())
  employeeId         Int              @map("employee_id")
  attendanceImportId Int?             @map("attendance_import_id")
  attendanceDate     DateTime         @map("attendance_date") @db.Date
  checkinAt          DateTime?        @map("checkin_at")
  checkoutAt         DateTime?        @map("checkout_at")
  checkinLocation    String?          @map("checkin_location")
  checkoutLocation   String?          @map("checkout_location")
  attendanceType     AttendanceType   @map("attendance_type")
  durationHours      Decimal?         @map("duration_hours") @db.Decimal(5, 2)
  status             AttendanceStatus
  verificationStatus String           @map("verification_status")
  verifiedByRole     String?          @map("verified_by_role")
  remarks            String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  employee         Employee          @relation(fields: [employeeId], references: [id])
  attendanceImport AttendanceImport? @relation(fields: [attendanceImportId], references: [id])

  @@unique([employeeId, attendanceDate])
  @@map("attendances")
}

model AttendanceSummary {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @map("employee_id")
  periodYear       Int      @map("period_year")
  periodMonth      Int      @map("period_month")
  hadir            Int
  cuti             Int
  kuotaCuti        Int      @map("kuota_cuti")
  izin             Int
  kuotaIzin        Int      @map("kuota_izin")
  unpaidLeave      Int      @map("unpaid_leave")
  kuotaUnpaidLeave Int      @map("kuota_unpaid_leave")
  statusHadir      String   @map("status_hadir")
  calculatedAt     DateTime @map("calculated_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, periodYear, periodMonth])
  @@map("attendance_summaries")
}

model TransportAllowanceSetting {
  id             Int      @id @default(autoincrement())
  baseFare       Decimal  @map("base_fare") @db.Decimal(10, 2)
  effectiveStart DateTime @map("effective_start") @db.Date
  minKm          Decimal  @map("min_km") @db.Decimal(6, 2)
  maxKm          Decimal  @map("max_km") @db.Decimal(6, 2)
  isActive       Boolean  @map("is_active")
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  createdByUser User? @relation(fields: [createdBy], references: [id])

  @@map("transport_allowance_settings")
}

enum TransportPeriodStatus {
  draft
  calculated
  locked
}

model TransportAllowancePeriod {
  id              Int                   @id @default(autoincrement())
  periodYear      Int                   @map("period_year")
  periodMonth     Int                   @map("period_month")
  totalRecipients Int                   @map("total_recipients")
  totalAmount     Decimal               @map("total_amount") @db.Decimal(14, 2)
  status          TransportPeriodStatus
  calculatedBy    Int?                  @map("calculated_by")
  calculatedAt    DateTime?             @map("calculated_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  calculatedByUser User?                      @relation(fields: [calculatedBy], references: [id])
  details          TransportAllowanceDetail[]

  @@unique([periodYear, periodMonth])
  @@map("transport_allowance_periods")
}

model TransportAllowanceDetail {
  id                         Int      @id @default(autoincrement())
  transportAllowancePeriodId Int      @map("transport_allowance_period_id")
  employeeId                 Int      @map("employee_id")
  baseFare                   Decimal  @map("base_fare") @db.Decimal(10, 2)
  originalKm                 Decimal  @map("original_km") @db.Decimal(6, 2)
  roundedKm                  Decimal  @map("rounded_km") @db.Decimal(6, 2)
  attendanceDays             Int      @map("attendance_days")
  nominal                    Decimal  @db.Decimal(14, 2)
  eligibilityStatus          String   @map("eligibility_status")
  calculationNote            String?  @map("calculation_note") @db.Text
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  period   TransportAllowancePeriod @relation(fields: [transportAllowancePeriodId], references: [id])
  employee Employee                 @relation(fields: [employeeId], references: [id])

  @@unique([transportAllowancePeriodId, employeeId])
  @@map("transport_allowance_details")
}
